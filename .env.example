# Copy to .env for local development. Never commit .env itself.

# Port the server listens on. In production the platform sets this for us.
PORT=3000

# Comma-separated list of origins whose page JavaScript may read our responses.
# An origin is scheme + host + port, with NO trailing slash and NO path.
# In production this is the deployed frontend, e.g.
#   CORS_ORIGINS=https://demo-gallery.vercel.app
CORS_ORIGINS=http://localhost:5173

# Postgres connection string. THIS IS A SECRET — it contains the password and
# grants full access to the database. Environment variable only; never in git,
# never in the frontend bundle.
#
# From the Neon dashboard, take the POOLED string (its host contains "-pooler").
#
# Change the ?sslmode=require it ships with to ?sslmode=verify-full. Under
# libpq's real semantics "require" means "encrypt, but do not check who you are
# talking to" — which stops passive eavesdropping but not an active
# man-in-the-middle. verify-full also validates the certificate and hostname.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full
