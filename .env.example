# Copy to .env for local development. Never commit .env itself.

# Port the server listens on. In production the platform sets this for us.
PORT=3000

# Comma-separated list of origins whose page JavaScript may read our responses.
# An origin is scheme + host + port, with NO trailing slash and NO path.
# In production this is the deployed frontend, e.g.
#   CORS_ORIGINS=https://demo-gallery.vercel.app
CORS_ORIGINS=http://localhost:5173

# Postgres connection string. THIS IS A SECRET — it contains the password and
# grants full access to the database. Environment variable only; never in git,
# never in the frontend bundle.
#
# From the Neon dashboard, take the POOLED string (its host contains "-pooler").
#
# Change the ?sslmode=require it ships with to ?sslmode=verify-full. Under
# libpq's real semantics "require" means "encrypt, but do not check who you are
# talking to" — which stops passive eavesdropping but not an active
# man-in-the-middle. verify-full also validates the certificate and hostname.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# --- Object storage (Stage 2) --------------------------------------------
#
# Supabase Storage, spoken to over the S3 protocol. We use the S3 API rather
# than Supabase's own client library on purpose: S3 is the de facto standard
# that R2, Backblaze, MinIO, DigitalOcean Spaces and AWS itself all implement,
# so this code moves between providers by changing these five values.

# The S3 endpoint for your project. Not a normal Supabase URL — note the
# /storage/v1/s3 suffix. Project Settings -> Storage.
S3_ENDPOINT=https://YOUR-PROJECT-REF.supabase.co/storage/v1/s3

# Must match the region the project was created in. The region is an input to
# the request signature, so a wrong value here fails with a signature error
# that says nothing about regions.
S3_REGION=eu-central-1

# NOT a secret. Identifies which key was used to sign; travels in the clear
# inside every signed URL.
S3_ACCESS_KEY_ID=

# THIS IS A SECRET. Never leaves the server. It is never sent to storage
# either — it is the HMAC key used to *compute* signatures locally, and
# Supabase verifies them with its own copy. If it leaks, anyone can mint
# unlimited upload and delete URLs for your bucket.
S3_SECRET_ACCESS_KEY=

# Bucket name.
S3_BUCKET=drawings

# Base URL for reading objects back. Public bucket, so no signature needed on
# reads — the URL is built as `${PUBLIC_STORAGE_URL}/${storage_key}`.
PUBLIC_STORAGE_URL=https://YOUR-PROJECT-REF.supabase.co/storage/v1/object/public/drawings

# --- Rate limiting (Stage 5) ---------------------------------------------
#
# None of these are secrets. They are here because a limit is environment
# specific: what protects a 512 MiB free instance would throttle a real one,
# and what is comfortable while developing is far too loose in production.

# HOW MANY PROXIES SIT IN FRONT OF THIS SERVER.
#
# NOT a preference — a fact about the deployment, and getting it wrong breaks
# rate limiting silently in one of two directions:
#
#   too low  -> req.ip is the proxy, so every caller shares one bucket and the
#               limiter refuses the whole internet at once
#   too high -> req.ip is taken from a part of X-Forwarded-For the CLIENT wrote,
#               so anyone can forge a fresh bucket per request and walk through
#
# 0 locally, where nothing is in front of us. In production, send one request
# and read the server log: it prints both ip= and xff=. Count the entries in
# xff and set this so that ip= comes out as the real client address.
TRUST_PROXY_HOPS=0

# Global per-IP ceiling, per minute, across every endpoint except /health.
# The floor that stops one caller occupying the process. Not the login defence.
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# Per-IP cap on signup and login over 15 minutes. These are the only endpoints
# that run scrypt (~300ms and 16 MiB each on Render), so they are the only ones
# worth defending this tightly. Raise it locally if the check scripts trip it.
RATE_LIMIT_AUTH_PER_IP=20

# FAILED logins per email address over 15 minutes. Successes are not counted and
# a success clears the count, so a user who types their password correctly is
# never affected by someone else attacking their address.
RATE_LIMIT_LOGIN_FAILURES=5
